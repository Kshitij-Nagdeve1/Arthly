<% layout('layouts/boilerplate.ejs') -%>

    <body>
        <div class="signup-container">
            <div class="signup-form">

                <div class="signup-heading">

                    <h2>Create Your Account</h2>
                    <p>Start Arthly and start managing your finances</p>

                </div>

                <div class="signup-content">
                    <form action="/signup" method="POST" novalidate>
                        <div class="input-box">
                            <label for="username">Username</label>
                            <div class="input">
                                <div class="icon">
                                    <i class="fa-solid fa-user"></i>
                                </div>
                                <input type="text" id="username" minlength="3" maxlength="20" name="username"
                                    placeholder="Enter your username"
                                    title="Username must be 3-20 characters and contain only letters and numbers."
                                    required>
                            </div>
                            <%- include('../includes/errmsg.ejs') %>
                        </div>

                        <div class="input-box">
                            <label for="email">Email</label>
                            <div class="input">
                                <div class="icon">
                                    <i class="fa-regular fa-envelope"></i>
                                </div>
                                <input type="email" id="email" name="email" title="" placeholder="Enter your email"
                                    required>
                            </div>
                            <%- include('../includes/errmsg.ejs') %>
                        </div>

                        <div class="input-box">
                            <label for="password">Password</label>
                            <div class="input">
                                <div class="icon">
                                    <i class="fa-solid fa-lock"></i>
                                </div>
                                <input type="password" minlength="8" pattern="(?=.*\d)(?=.*[A-Z]).{8,}" id="password"
                                    name="password" placeholder="Enter your password"
                                    title="Password must be at least 8 characters long, contain at least one uppercase letter, and one number."
                                    required>
                            </div>
                            <%- include('../includes/errmsg.ejs') %>
                        </div>
                        <button class="form-btn" id="submitBtn">Sign up</button>

                    </form>

                    <div class="or">
                        <hr>
                        <span>or</span>
                        <hr>
                    </div>

                    <div class="already-account">
                        <p>Already have an account?</p>
                        <a href="/login">Login</a>
                    </div>

                </div>
            </div>
        </div>

        <script type="module" src="/javascript/login.js"></script>
    </body>