<% layout('layouts/boilerplate.ejs') -%>

    <body>

        <div class="form-container">

            <%- include('../includes/sidebar.ejs') %>

                <section class="main-container">

                    <div class="top-pannel">
                        <%- include('../includes/userpannel.ejs') %>
                    </div>

                    <div class="form">
                        <div class="form-inner-container">
                            <div class="form-heading">
                                <h2>Set Monthly Budget</h2>
                                <p>Plan your spending. Save for what matters.</p>
                            </div>
                            <div class="form-content">

                                <form action="/budgets" method="POST" id="budgetForm" novalidate>

                                    <div class="input-box">
                                        <label for="budget">Budget</label>
                                        <div class="input">
                                            <div class="icon">
                                                <i class="fa-solid fa-hand-holding-dollar"></i>
                                            </div>
                                            <input type="number" min="1" id="budget" name="budget[totalBudget]"
                                                placeholder="Set Monthly Budget" required>

                                        </div>
                                        <%- include('../includes/errmsg.ejs') %>
                                    </div>

                                    <div class="input-box">
                                        <label for="month">Month</label>
                                        <div class="input">
                                            <div class="icon">
                                                <i class="fa-regular fa-calendar"></i>
                                            </div>

                                            <select name="budget[month]" id="month" required>
                                                <option value="" selected disabled>Select the month</option>
                                                <option value="1">January</option>
                                                <option value="2">February</option>
                                                <option value="3">March</option>
                                                <option value="4">April</option>
                                                <option value="5">May</option>
                                                <option value="6">June</option>
                                                <option value="7">July</option>
                                                <option value="8">August</option>
                                                <option value="9">September</option>
                                                <option value="10">October</option>
                                                <option value="11">November</option>
                                                <option value="12">December</option>
                                            </select>
                                        </div>
                                        <%- include('../includes/errmsg.ejs') %>
                                    </div>


                                    <div class="input-box">
                                        <label for="year">Year</label>
                                        <div class="input">
                                            <div class="icon">
                                                <i class="fa-regular fa-circle-dot"></i>
                                            </div>
                                            <input type="number" min="2000" max="2100" id="year" name="budget[year]"
                                                placeholder="Enter year" required>

                                        </div>
                                        <%- include('../includes/errmsg.ejs') %>
                                    </div>

                                    <div class="btn-box">
                                        <div class="btn">
                                            <button id="submitBtn"><i class="fa-solid fa-floppy-disk"></i>
                                                Save Budget</button>
                                        </div>
                                    </div>

                                </form>
                            </div>
                        </div>
                    </div>

                </section>

        </div>


        <script type="module" src="/javascript/budgetForm.js"></script>

    </body>


    </html>